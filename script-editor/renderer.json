{
  "id": "lingjing.script-editor",
  "name": "LingJing Script Editor",
  "priority": 100,
  "capabilities": [
    "interactiveHtml",
    "localResources",
    "documentActions"
  ],
  "assetRoot": "{rendererRoot}",
  "command": [
    "/bin/sh",
    "{rendererRoot}/launch.sh",
    "{rendererRoot}/renderer.mjs"
  ],
  "match": {
    "detectedKinds": [
      "structuredData"
    ]
  }
}
