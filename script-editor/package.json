{
  "name": "reef-script-editor-renderer",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --format=iife --platform=browser --target=es2022 --minify --loader:.css=text --outfile=script-editor.min.js && cp node_modules/@lingjingai/script-editor/dist/paper-fibers.png paper-fibers.png",
    "install:renderer": "node install.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lingjingai/script-editor": "0.7.16",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.10",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
